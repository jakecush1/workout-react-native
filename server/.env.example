DATABASE_URL="postgresql://workout:workout@localhost:5433/workout?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000

# ---- AI (plan generation + coach chat) --------------------------------------
# All optional. The first one found is used, checked in this order.
# With none set, the server auto-detects a local Ollama at localhost:11434,
# and otherwise falls back to the built-in rule-based plan generator (chat off).

# Anthropic Claude (paid, best quality)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Groq - free tier, fast, good quality (console.groq.com, no card needed)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini - free tier (aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter - free models (openrouter.ai)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama - 100% free and local, auto-detected when running (ollama.com)
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434

# Any other OpenAI-compatible server
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
